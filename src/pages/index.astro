---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '数智人心 —— 数字化时代的人力资源管理随笔',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="container mx-auto px-4 py-20 md:py-28 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight">
      你好，欢迎来到<span class="text-blue-600 dark:text-blue-400">数智人心</span>
    </h1>
<p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed">
  在算法与数据之外看见组织里的人<br>
  记录一位研究者的人力资源数字化观察笔记
</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/blog"
        class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
      >
        浏览博客
      </a>
      <a
        href="/about"
        class="px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition font-medium"
      >
        关于我
      </a>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12 md:py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">最新文章</h2>
      <p class="text-gray-500 dark:text-gray-400 mb-4">
        博客聚焦人力资源数字化转型、人才管理、组织发展等主题，持续更新中。
      </p>
      <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
        查看全部文章 →
      </a>
    </div>
  </section>
</Layout>
